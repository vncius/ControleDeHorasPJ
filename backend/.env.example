PORT=3001
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Obrigatório. Em produção: 32+ bytes e diferente deste exemplo (openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret
# Quem pode logar é controlado no Google Cloud Console (OAuth consent screen:
# app "Testing" com lista de test users, ou "Internal" restrito ao Workspace),
# não há mais allowlist própria aqui.
# Em produção, uma ou mais origins do frontend separadas por vírgula
# (ex.: https://app.seudominio.com,https://staging.seudominio.com)
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=horas-pj
# Banco usado quando NODE_ENV=test — obrigatoriamente diferente do de produção
MONGODB_DB_NAME_TEST=horas-pj-test
