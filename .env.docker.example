# Copie para .env.docker (fora do git) e preencha com os valores de PRODUÇÃO,
# os mesmos configurados hoje no Render. Usado pelo docker-compose.yml.

# Porta local do app: http://localhost:8081 (a 8080 fica livre para o
# GestaoFinanceiraDev). Ela precisa estar em "Origens JavaScript autorizadas"
# do Client ID no Google Cloud Console.
APP_PORT=8081

MONGODB_URI=
MONGODB_DB_NAME=horas-pj

# Mesmo valor do Render: com outro, todos precisam logar de novo.
# Em produção: 32+ bytes (openssl rand -base64 48).
JWT_SECRET=

GOOGLE_CLIENT_ID=

# Exibidos nos Termos de Uso e na Política de Privacidade.
VITE_LEGAL_CONTROLADOR=
VITE_LEGAL_CONTATO=
